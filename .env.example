# Copiez ce fichier vers .env.local et renseignez les valeurs.
# Ne committez jamais .env.local ni un fichier contenant de vrais secrets.
# Les clés serveur ci-dessous ne doivent JAMAIS être préfixées par NEXT_PUBLIC_.

# --- Supabase ---
# Clés publiques (protégées par les politiques RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement : routes API et Server Actions
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (assistant SMS) ---
# Serveur uniquement
OPENAI_API_KEY=
# Modèle utilisé pour les réponses SMS (défaut : gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# --- Stripe ---
# Serveur uniquement
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Twilio (SMS entrants) ---
# Serveur uniquement
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# URL exacte configurée dans la console Twilio, utilisée pour vérifier la
# signature (ex. https://app.velianos.fr/api/webhooks/twilio).
TWILIO_WEBHOOK_URL=

# --- Notifications Web Push (VAPID) ---
# Générez une paire de clés avec : npx web-push generate-vapid-keys
# Clé publique exposée au navigateur (obligatoirement préfixée NEXT_PUBLIC_)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Clés privées : serveur uniquement
VAPID_PRIVATE_KEY=
# Contact VAPID, au format mailto:contact@example.com
VAPID_SUBJECT=mailto:contact@velianos.app

# Secret partagé pour les appels serveur à /api/push/notify
# (Edge Functions Supabase, cron, etc.). Serveur uniquement.
PUSH_NOTIFY_SECRET=

# URL publique de l'application (utilisée par les intégrations serveur)
APP_URL=http://localhost:3000
